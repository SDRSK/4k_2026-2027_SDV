digraph ER {
graph [rankdir=LR, pad=0.4, nodesep=0.6, ranksep=1.5, bgcolor="white", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#64748b", penwidth=1.7, dir=none];
books [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="12"><B>КНИГА / books</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK book_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">AK isbn: VARCHAR(13)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">title: VARCHAR(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">publication_year: SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">category: VARCHAR(100)</FONT></TD></TR></TABLE>>];
authors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="12"><B>АВТОР / authors</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK author_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">full_name: VARCHAR(200)</FONT></TD></TR></TABLE>>];
book_authors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="12"><B>КНИГА—АВТОР / book_authors</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK, FK book_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK, FK author_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">author_order: SMALLINT</FONT></TD></TR></TABLE>>];
copies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="12"><B>ПРИМІРНИК / copies</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK copy_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">FK book_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">AK inventory_number: VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">condition: VARCHAR(20)</FONT></TD></TR></TABLE>>];
readers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="12"><B>ЧИТАЧ / readers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK reader_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">AK card_number: VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">full_name: VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">email: VARCHAR(254)</FONT></TD></TR></TABLE>>];
librarians [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="12"><B>БІБЛІОТЕКАР / librarians</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK librarian_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">AK employee_number: VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">full_name: VARCHAR(200)</FONT></TD></TR></TABLE>>];
loans [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="12"><B>ВИДАЧА / loans</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">PK loan_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">FK copy_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">FK reader_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">FK librarian_id: UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">issued_at: DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">due_at: DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><FONT POINT-SIZE="10">returned_at: DATE NULL</FONT></TD></TR></TABLE>>];
books -> copies [taillabel="1", headlabel="0..N", labeldistance=2.1, labelangle=20];
books -> book_authors [taillabel="1", headlabel="0..N", labeldistance=2.1, labelangle=20];
authors -> book_authors [taillabel="1", headlabel="0..N", labeldistance=2.1, labelangle=20];
copies -> loans [taillabel="1", headlabel="0..N", labeldistance=2.1, labelangle=20];
readers -> loans [taillabel="1", headlabel="0..N", labeldistance=2.1, labelangle=20];
librarians -> loans [taillabel="1", headlabel="0..N", labeldistance=2.1, labelangle=20];
}